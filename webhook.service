[Unit]
Description=GitHub Webhook Server for 42cursus
After=network.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/42cursus
EnvironmentFile=/home/user/42cursus/.env
ExecStart=/usr/bin/python3 /home/user/42cursus/webhook_server.py
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webhook-42cursus

[Install]
WantedBy=multi-user.target
