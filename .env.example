# GitHub Webhook Configuration

# Webhook secret (set this in GitHub webhook settings)
# Generate a secure random string: openssl rand -hex 32
WEBHOOK_SECRET=your_webhook_secret_here

# Repository path (absolute path to the megarepo)
REPO_PATH=/home/user/42cursus

# Git branch to use for updates
GIT_BRANCH=claude/github-webhook-submodules-SFaoA

# Enable automatic push to remote after updating submodules
# Set to 'false' if you want to review changes before pushing
ENABLE_AUTO_PUSH=true

# Server configuration
HOST=0.0.0.0
PORT=5000
